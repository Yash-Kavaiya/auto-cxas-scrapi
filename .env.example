# ─── Environment ───────────────────────────────────────────────────────────────────
AUTO_CXAS_ENV=development

# ─── Google Cloud ────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ─── Target CXAS Resources ───────────────────────────────────────────────────
AUTO_CXAS_APP_NAME=your-app-display-name
AUTO_CXAS_AGENT_NAME=

# ─── LLM Backend ────────────────────────────────────────────────────────────
AUTO_CXAS_LLM_PROVIDER=gemini
AUTO_CXAS_LLM_MODEL=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Experiment Loop ──────────────────────────────────────────────────────────
AUTO_CXAS_APPROVAL_MODE=manual
AUTO_CXAS_MIN_SCORE_DELTA=0.01
AUTO_CXAS_MAX_EXPERIMENTS_PER_LOOP=50

# ─── Evaluation ─────────────────────────────────────────────────────────────────────
AUTO_CXAS_MAX_PARALLEL_EVALS=3
AUTO_CXAS_EVAL_TIMEOUT_SECONDS=180
AUTO_CXAS_BASELINE_CACHE_TTL_SECONDS=300

# ─── Convergence Detection ────────────────────────────────────────────────────────
AUTO_CXAS_CONVERGENCE_WINDOW=10
AUTO_CXAS_CONVERGENCE_THRESHOLD=0.002

# ─── Callback Server ───────────────────────────────────────────────────────────────
AUTO_CXAS_CALLBACK_SERVER_URL=
AUTO_CXAS_CALLBACK_SECRET=

# ─── Storage ────────────────────────────────────────────────────────────────────────────
AUTO_CXAS_RUNS_DIR=.auto-cxas/runs
AUTO_CXAS_STATE_DIR=.auto-cxas/state

# ─── Reporting ────────────────────────────────────────────────────────────────────────────
AUTO_CXAS_GENERATE_HTML_REPORT=false
AUTO_CXAS_REPORT_DIR=.auto-cxas/reports

# ─── GCS Export ───────────────────────────────────────────────────────────────────────────
AUTO_CXAS_GCS_RESULTS_BUCKET=

# ─── Observability ─────────────────────────────────────────────────────────────────────────
AUTO_CXAS_LOG_LEVEL=INFO
