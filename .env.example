# ─── Environment ──────────────────────────────────────────────────────
AUTO_CXAS_ENV=development

# ─── Google Cloud ─────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ─── Target CXAS Resources ────────────────────────────────────────────
AUTO_CXAS_APP_NAME=your-app-display-name
AUTO_CXAS_AGENT_NAME=

# ─── LLM Backend ─────────────────────────────────────────────────────
# Options: gemini | anthropic | openai
AUTO_CXAS_LLM_PROVIDER=gemini
AUTO_CXAS_LLM_MODEL=

# Provider API keys
# Gemini: on Cloud Shell/GCE leave blank (ADC used). Otherwise set GEMINI_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Experiment Loop ──────────────────────────────────────────────────
AUTO_CXAS_APPROVAL_MODE=manual
AUTO_CXAS_MIN_SCORE_DELTA=0.01
AUTO_CXAS_MAX_EXPERIMENTS_PER_LOOP=50

# ─── Evaluation ───────────────────────────────────────────────────────
AUTO_CXAS_MAX_PARALLEL_EVALS=2
AUTO_CXAS_EVAL_TIMEOUT_SECONDS=120
AUTO_CXAS_BASELINE_CACHE_TTL_SECONDS=300

# ─── Storage ───────────────────────────────────────────────────────────────
AUTO_CXAS_RUNS_DIR=.auto-cxas/runs
AUTO_CXAS_STATE_DIR=.auto-cxas/state

# ─── Observability ────────────────────────────────────────────────────────
AUTO_CXAS_LOG_LEVEL=INFO
